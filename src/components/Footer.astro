---
interface Props {
  /** The projects and contact pages link Home in place of their own entry. */
  homeInsteadOf?: 'projects' | 'contact';
}
const { homeInsteadOf } = Astro.props;
const home = { href: '/', label: 'Home' };
const navigate = [
  homeInsteadOf === 'projects' ? home : { href: '/projects/', label: 'Projects' },
  { href: '/studio/', label: 'Studio' },
  { href: '/career/', label: 'Careers' },
  homeInsteadOf === 'contact' ? home : { href: '/contact/', label: 'Contact' },
  { href: '/cookie-policy/', label: 'Cookie Policy' },
  { href: '/accessibility/', label: 'Accessibility' },
];
---
<footer class="site-footer">
  <div class="top">
    <img src="/assets/logo.png" alt="Bellish" width="320" height="132">
    <div class="cols">
      <div>
        <div class="label">Navigate</div>
        {navigate.map((l) => <a href={l.href}>{l.label}</a>)}
        <button type="button" class="linklike" data-consent-open>Cookie settings</button>
      </div>
      <div>
        <div class="label">Connect</div>
        <a href="https://www.instagram.com/bellisharchitects" target="_blank" rel="noopener">Instagram</a>
        <a href="https://wa.me/972546077729" target="_blank" rel="noopener">WhatsApp</a>
        <a href="mailto:office@bellish.co.il">Email</a>
      </div>
    </div>
  </div>
  <div class="bottom">
    <span>© 2026 Bellish Architects. <span lang="he">בליש אדריכלים</span></span>
    <span>Architects Firm</span>
  </div>
</footer>
