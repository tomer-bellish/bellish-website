---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormScript from '../../components/FormScript.astro';
import { jobs, updatedMonth, careerDescription } from '../../data/jobs';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://bellish.co.il/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Careers",
        "item": "https://bellish.co.il/career/"
      }
    ]
  }
];
---
<Base
  title="Careers — Bellish Architects"
  description={careerDescription}
  path="/career/"
  jsonLd={jsonLd}
>
  <div style="background:#F5F4F2; color:#111110; min-height:100vh;">
    <Header current="career" />
    <main id="main">

  <!-- HEADER -->
  <section class="reveal" style="padding:clamp(64px,11vw,96px) clamp(20px,5vw,48px) 88px; max-width:1320px; margin:0 auto;">
    <div style="font-family:'Archivo',sans-serif; font-size:12px; letter-spacing:0.2em; text-transform:uppercase; color:#71706B; margin-bottom:26px;">Join the studio</div>
    <h1 style="font-family:'Archivo',sans-serif; font-weight:800; font-size:clamp(52px,8.5vw,128px); line-height:0.88; letter-spacing:-0.05em; text-transform:lowercase; margin-bottom:48px;">careers</h1>
    <p style="font-family:'Archivo',sans-serif; font-weight:500; font-size:clamp(22px,2.8vw,36px); line-height:1.32; letter-spacing:-0.02em; max-width:980px; text-wrap:pretty;">We are a small studio that takes on a limited number of projects — which means every person here has real ownership over the work. If you care about light, detail, and doing fewer things well, we'd like to meet you.</p>
  </section>

  <!-- VALUES -->
  <section class="reveal" style="padding:0 clamp(20px,5vw,48px) 112px; max-width:1320px; margin:0 auto;">
    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr)); gap:48px;">
      <div style="border-top:1px solid #111110; padding-top:24px;">
        <div style="font-family:monospace; font-size:12px; color:#70706C; margin-bottom:20px;">01</div>
        <h2 style="font-family:'Archivo',sans-serif; font-weight:800; font-size:22px; letter-spacing:-0.025em; text-transform:lowercase; margin-bottom:14px;">real responsibility</h2>
        <p style="font-size:14.5px; line-height:1.65; color:#56554F;">You'll work directly on live projects from concept to construction — not buried three layers deep in a large office.</p>
      </div>
      <div style="border-top:1px solid #111110; padding-top:24px;">
        <div style="font-family:monospace; font-size:12px; color:#70706C; margin-bottom:20px;">02</div>
        <h2 style="font-family:'Archivo',sans-serif; font-weight:800; font-size:22px; letter-spacing:-0.025em; text-transform:lowercase; margin-bottom:14px;">craft over volume</h2>
        <p style="font-size:14.5px; line-height:1.65; color:#56554F;">We protect the time it takes to resolve a detail properly. Fewer projects, more care, on every drawing that leaves the studio.</p>
      </div>
      <div style="border-top:1px solid #111110; padding-top:24px;">
        <div style="font-family:monospace; font-size:12px; color:#70706C; margin-bottom:20px;">03</div>
        <h2 style="font-family:'Archivo',sans-serif; font-weight:800; font-size:22px; letter-spacing:-0.025em; text-transform:lowercase; margin-bottom:14px;">a studio, not a factory</h2>
        <p style="font-size:14.5px; line-height:1.65; color:#56554F;">Eight people, one room, shared decisions. We learn from each other's work and grow the practice together.</p>
      </div>
    </div>
  </section>

  <!-- OPEN POSITIONS -->
  <section class="reveal" style="padding:0 48px 120px; max-width:1320px; margin:0 auto;">
    <div style="display:flex; align-items:baseline; justify-content:space-between; border-bottom:1px solid #D8D7D2; padding-bottom:18px; margin-bottom:8px; gap:24px; flex-wrap:wrap;">
      <h2 style="font-family:'Archivo',sans-serif; font-weight:800; font-size:clamp(28px,3vw,44px); letter-spacing:-0.035em; text-transform:lowercase;">open positions</h2>
      <span style="font-size:11.5px; letter-spacing:0.14em; text-transform:uppercase; color:#71706B;">{jobs.length} {jobs.length === 1 ? 'role' : 'roles'} · updated {updatedMonth}</span>
    </div>

    {jobs.map((j) => (
      <a href="#apply" class="role" style="display:flex; flex-wrap:wrap; align-items:center; gap:10px 24px; padding:28px 0; border-bottom:1px solid #E2E1DD;">
        <h3 style="flex:1 1 200px; font-family:'Archivo',sans-serif; font-weight:800; font-size:clamp(24px,2.4vw,34px); letter-spacing:-0.03em; text-transform:lowercase;">{j.title.toLowerCase()}</h3>
        <div class="rmeta" style="font-size:12px; letter-spacing:0.12em; text-transform:uppercase; color:#71706B;">{j.type}</div>
        <div class="rmeta" style="font-size:12px; letter-spacing:0.12em; text-transform:uppercase; color:#71706B;">{j.office}</div>
        <span class="rapply" style="margin-left:auto; display:flex; align-items:center; gap:10px; font-size:13px; font-weight:500; white-space:nowrap;">apply <span class="ra" style="font-size:16px;">→</span></span>
      </a>
    ))}
    {!jobs.length && (
      <p style="padding:28px 0; border-bottom:1px solid #E2E1DD; font-size:15px; line-height:1.7; color:#56554F;">No open positions right now — open applications are always welcome.</p>
    )}
  </section>

  <!-- APPLICATION FORM -->
  <section id="apply" class="reveal" style="background:#111110; color:#F0EFEB; padding:clamp(64px,11vw,120px) clamp(20px,5vw,48px); scroll-margin-top:90px;">
    <div style="max-width:1320px; margin:0 auto; display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr)); gap:48px 80px; align-items:start;">
      <div>
        <div style="font-size:11.5px; letter-spacing:0.2em; text-transform:uppercase; color:#86857F; margin-bottom:28px;">Apply</div>
        <h2 style="font-family:'Archivo',sans-serif; font-weight:800; font-size:clamp(34px,4.6vw,68px); line-height:0.94; letter-spacing:-0.04em; text-transform:lowercase; margin-bottom:32px;">send us<br>your work.</h2>
        <p style="font-size:15px; line-height:1.8; color:#B6B5AF; max-width:380px;">Tell us which role you're after and share a link to your portfolio. We read every application and reply to the ones that fit.</p>
        <div style="margin-top:36px; font-size:14px; color:#86857F;">Prefer email? <a class="h-career-1" href="mailto:office@bellish.co.il?subject=Application" style="color:#F0EFEB; border-bottom:1px solid #3A3A37; padding-bottom:2px;">office@bellish.co.il</a></div>
      </div>

      <div id="career-sent" hidden style="display:flex; flex-direction:column; justify-content:center; min-height:280px; border-top:1px solid #262624; padding-top:40px;">
          <div style="font-family:'Archivo',sans-serif; font-weight:800; font-size:clamp(28px,3.2vw,44px); letter-spacing:-0.04em; text-transform:lowercase; margin-bottom:16px;">application sent.</div>
          <p style="font-size:16px; line-height:1.7; color:#B6B5AF; max-width:440px;">Thank you for your interest in Bellish. We've received your details and will be in touch if there's a fit.</p>
        </div>

      <form action="https://formspree.io/f/meeblnpq" method="POST" data-endpoint="https://formspree.io/f/meeblnpq" data-sent="career-sent" data-error-msg="Something went wrong — please email your application to office@bellish.co.il." style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr)); gap:24px 32px;">
          <input type="hidden" name="_subject" value="New job application — bellish.co.il">
          <div class="hp"><label for="career-hp">Leave this field empty</label><input id="career-hp" type="text" name="_gotcha" tabindex="-1" autocomplete="off"></div>
          <div style="display:flex; flex-direction:column; gap:10px;">
            <label for="career-f1" style="font-size:11px; letter-spacing:0.14em; text-transform:uppercase; color:#86857F;">Full name <span aria-hidden="true">*</span></label>
            <input id="career-f1" class="fin" name="name" type="text" placeholder="Your name" required="required">
          </div>
          <div style="display:flex; flex-direction:column; gap:10px;">
            <label for="career-f2" style="font-size:11px; letter-spacing:0.14em; text-transform:uppercase; color:#86857F;">Email <span aria-hidden="true">*</span></label>
            <input id="career-f2" class="fin" name="email" type="email" placeholder="you@email.com" required="required">
          </div>
          <div style="display:flex; flex-direction:column; gap:10px;">
            <label for="career-f3" style="font-size:11px; letter-spacing:0.14em; text-transform:uppercase; color:#86857F;">Position</label>
            <select id="career-f3" class="fin" name="position">
              {jobs.map((j) => <option>{j.title}</option>)}
              <option>Open application</option>
            </select>
          </div>
          <div style="display:flex; flex-direction:column; gap:10px;">
            <label for="career-f4" style="font-size:11px; letter-spacing:0.14em; text-transform:uppercase; color:#86857F;">Portfolio link</label>
            <input id="career-f4" class="fin" name="portfolio" type="url" placeholder="https://">
          </div>
          <div style="display:flex; flex-direction:column; gap:10px; grid-column:1 / -1;">
            <label for="career-f5" style="font-size:11px; letter-spacing:0.14em; text-transform:uppercase; color:#86857F;">A few words about you</label>
            <textarea id="career-f5" class="fin" name="message" rows="3" placeholder="What you're looking for, and why Bellish." style="resize:vertical;"></textarea>
          </div>
          <div style="grid-column:1 / -1; margin-top:8px;">
            <p style="font-size:12.5px; line-height:1.6; color:#B6B5AF; max-width:560px; margin-bottom:20px;">Fields marked * are required. We use your details only to consider your application; giving them is voluntary. The form is delivered by Formspree (USA). <a href="/cookie-policy/#your-data" style="color:#F0EFEB; text-decoration:underline;">Privacy policy</a></p>
            <button class="h-career-2" type="submit" style="cursor:pointer; font-family:'Archivo',sans-serif; font-weight:800; font-size:15px; letter-spacing:-0.01em; text-transform:lowercase; color:#111110; background:#F0EFEB; border:none; padding:16px 34px; border-radius:999px; transition:opacity .25s ease;">send application</button>
            <div style="min-height:18px; margin-top:16px; font-size:13.5px; color:#E0846F;" data-error role="status" aria-live="polite"></div>
          </div>
        </form>
    </div>
  </section>

    </main>
    <Footer />
  </div>
</Base>
<FormScript />

<style is:global>
.h-career-1:hover { border-bottom-color:#F0EFEB !important; }
.h-career-2:hover { opacity:0.82 !important; }
.role:hover { background: #111110; color: #F0EFEB; }
    .role:hover .rmeta { color: #B6B5AF; }
    .role:hover .rapply { color: #F0EFEB; }
    .role .ra { transition: transform .3s ease; }
    .role:hover .ra { transform: translateX(6px); }
    .fin { font-family: 'Archivo', sans-serif; background: transparent; border: none; border-bottom: 1px solid #61615F; padding: 12px 0 14px; font-size: 16px; color: #F0EFEB; width: 100%; }
    .fin::placeholder { color: #7D7C79; }
    .fin:focus { outline: none; border-bottom-color: #F0EFEB; }
    select.fin option { color: #111110; }
</style>
